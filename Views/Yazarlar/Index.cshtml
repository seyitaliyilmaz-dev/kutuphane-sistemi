@model List<kutuphane_sistemi.Models.Yazar>

<h2>Yazar Listesi</h2>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Yazar Ekle</a>

<table class="table">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Kitap Sayısı</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var yazar in Model)
        {
            <tr>
                <td>@yazar.AdSoyad</td>
                <td>@(yazar.Kitaplar?.Count ?? 0)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@yazar.YazarID" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@yazar.YazarID" class="btn btn-sm btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>