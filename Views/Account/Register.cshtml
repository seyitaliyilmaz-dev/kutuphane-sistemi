@model kutuphane_sistemi.Controllers.AccountController.KayitBilgisi

<h2>Öğrenci Kaydı</h2>

@if (ViewBag.Hata != null)
{
    <div class="alert alert-danger">@ViewBag.Hata</div>
}

<form asp-action="Register" method="post" style="max-width: 400px;">
    <div class="mb-3">
        <label>Ad Soyad</label>
        <input asp-for="AdSoyad" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Öğrenci No</label>
        <input asp-for="OgrenciNo" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Kullanıcı Adı</label>
        <input asp-for="KullaniciAdi" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Şifre</label>
        <input asp-for="Sifre" type="password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Kayıt Ol</button>
</form>

<p class="mt-3">Zaten hesabın var mı? <a asp-action="Login">Giriş Yap</a></p>