@model kutuphane_sistemi.Controllers.AccountController.GirisBilgisi

<h2>Kütüphaneci Girişi</h2>

@if (ViewBag.Hata != null)
{
    <div class="alert alert-danger">@ViewBag.Hata</div>
}

<form asp-action="Login" method="post" style="max-width: 400px;">
    <div class="mb-3">
        <label>Kullanıcı Adı</label>
        <input asp-for="KullaniciAdi" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Şifre</label>
        <input asp-for="Sifre" type="password" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Giriş Yap</button>
</form>