@model List<kutuphane_sistemi.Models.Kategori>

<h2>Kategoriler</h2>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Kategori Ekle</a>
}

<table class="table">
    <thead>
        <tr>
            <th>Kategori Adı</th>
            <th>Kitap Sayısı</th>
            @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <th>İşlemler</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var kategori in Model)
        {
            <tr>
                <td>@kategori.Ad</td>
                <td>@(kategori.Kitaplar?.Count ?? 0)</td>
                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <td>
                        <a asp-action="Delete" asp-route-id="@kategori.KategoriID" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>