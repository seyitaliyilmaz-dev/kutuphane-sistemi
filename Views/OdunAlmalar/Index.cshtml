@model List<kutuphane_sistemi.Models.OdunAlma>

<h2>Ödünç Alma Kayıtları</h2>

<a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Ödünç Alma</a>

<table class="table">
    <thead>
        <tr>
            <th>Kitap</th>
            <th>Öğrenci</th>
            <th>Alış Tarihi</th>
            <th>Son Teslim</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var odunAlma in Model)
        {
            bool gecTeslim = odunAlma.IadeTarihi == null && odunAlma.SonTeslimTarihi < DateTime.Now;
            <tr class="@(gecTeslim ? "table-danger" : "")">
                <td>@(odunAlma.Kitap?.Baslik ?? "Bilinmiyor")</td>
                <td>@(odunAlma.Ogrenci?.AdSoyad ?? "Bilinmiyor")</td>
                <td>@odunAlma.AlisTarihi.ToString("dd.MM.yyyy")</td>
                <td>@odunAlma.SonTeslimTarihi.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (odunAlma.IadeTarihi != null)
                    {
                        <span>İade edildi (@odunAlma.IadeTarihi.Value.ToString("dd.MM.yyyy"))</span>
                    }
                    else if (gecTeslim)
                    {
                        <strong>GECİKTİ</strong>
                    }
                    else
                    {
                        <span>Ödünçte</span>
                    }
                </td>
                <td>
                    @if (odunAlma.IadeTarihi == null)
                    {
                        <form asp-action="IadeEt" asp-route-id="@odunAlma.OdunAlmaID" method="post" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-success">İade Al</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>