@model List<kutuphane_sistemi.Models.Kitap>

<h2>Kitap Listesi</h2>

<form asp-action="Index" method="get" class="mb-3 d-flex gap-2 flex-wrap">
    <input type="text" name="arama" value="@ViewBag.AramaMetni" class="form-control" style="max-width: 300px;" placeholder="Başlık veya yazar ara..." />
    <button type="submit" class="btn btn-outline-primary">Ara</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>

    <select name="sirala" class="form-control" style="max-width: 220px;" onchange="this.form.submit()">
        <option value="baslik_az" selected="@(ViewBag.Sirala == "baslik_az")">Başlık (A-Z)</option>
        <option value="baslik_za" selected="@(ViewBag.Sirala == "baslik_za")">Başlık (Z-A)</option>
        <option value="durum_rafta_once" selected="@(ViewBag.Sirala == "durum_rafta_once")">Önce Rafta Olanlar</option>
        <option value="durum_oduncte_once" selected="@(ViewBag.Sirala == "durum_oduncte_once")">Önce Ödünçte Olanlar</option>
    </select>

    <select name="kategoriId" class="form-control" style="max-width: 220px;" onchange="this.form.submit()">
        <option value="">Tüm Kategoriler</option>
        @foreach (var kategori in (List<kutuphane_sistemi.Models.Kategori>)ViewBag.Kategoriler)
        {
            <option value="@kategori.KategoriID" selected="@(ViewBag.KategoriId == kategori.KategoriID)">@kategori.Ad</option>
        }
    </select>
</form>

@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Kitap Ekle</a>
}

<table class="table">
    <thead>
        <tr>
            <th>Başlık</th>
            <th>Yazar</th>
            <th>Kategori</th>
            <th>Durum</th>
            @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
            {
                <th>İşlemler</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var kitap in Model)
        {
            <tr>
                <td>@kitap.Baslik</td>
                <td>@(kitap.Yazar?.AdSoyad ?? "Bilinmiyor")</td>
                <td>@(kitap.Kategori?.Ad ?? "-")</td>
                <td>
                    @if (kitap.OduncDurumu)
                    {
                        <span class="badge bg-danger">Ödünçte</span>
                    }
                    else
                    {
                        <span class="badge bg-success">Rafta</span>
                    }
                </td>
                @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <td>
                        <a asp-action="Edit" asp-route-id="@kitap.KitapID" class="btn btn-sm btn-warning">Düzenle</a>
                        <a asp-action="Delete" asp-route-id="@kitap.KitapID" class="btn btn-sm btn-danger">Sil</a>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">Aramanıza uygun kitap bulunamadı.</p>
}

@{
    int mevcutSayfa = ViewBag.MevcutSayfa;
    int toplamSayfa = ViewBag.ToplamSayfa;
}

@if (toplamSayfa > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= toplamSayfa; i++)
            {
                <li class="page-item @(i == mevcutSayfa ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-sayfa="@i" asp-route-arama="@ViewBag.AramaMetni" asp-route-sirala="@ViewBag.Sirala" asp-route-kategoriId="@ViewBag.KategoriId">@i</a>
                </li>
            }
        </ul>
    </nav>
}