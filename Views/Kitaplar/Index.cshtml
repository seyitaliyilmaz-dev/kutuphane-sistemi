@model List<kutuphane_sistemi.Models.Kitap>

<h2>Kitap Listesi</h2>

<form asp-action="Index" method="get" class="mb-3 d-flex gap-2 flex-wrap">
    <input type="text" name="arama" value="@ViewBag.AramaMetni" class="form-control" style="max-width: 300px;" placeholder="Başlık veya yazar ara..." />
    <button type="submit" class="btn btn-outline-primary">Ara</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Temizle</a>

    <select name="sirala" class="form-control" style="max-width: 220px;" onchange="this.form.submit()">
        <option value="baslik_az" selected="@(ViewBag.Sirala == "baslik_az")">Başlık (A-Z)</option>
        <option value="baslik_za" selected="@(ViewBag.Sirala == "baslik_za")">Başlık (Z-A)</option>
        <option value="durum_rafta_once" selected="@(ViewBag.Sirala == "durum_rafta_once")">Önce Rafta Olanlar</option>
        <option value="durum_oduncte_once" selected="@(ViewBag.Sirala == "durum_oduncte_once")">Önce Ödünçte Olanlar</option>
    </select>

    <select name="kategoriId" class="form-control" style="max-width: 220px;" onchange="this.form.submit()">
        <option value="">Tüm Kategoriler</option>
        @foreach (var kategori in (List<kutuphane_sistemi.Models.Kategori>)ViewBag.Kategoriler)
        {
            <option value="@kategori.KategoriID" selected="@(ViewBag.KategoriId == kategori.KategoriID)">@kategori.Ad</option>
        }
    </select>
</form>

@if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Kitap Ekle</a>
}

@{
    int mevcutSayfa = ViewBag.MevcutSayfa;
    int toplamSayfa = ViewBag.ToplamSayfa;
    string aramaMetni = ViewBag.AramaMetni;
    string sirala = ViewBag.Sirala;
    int kategoriId = ViewBag.KategoriId;

    string SayfaLinki(int hedefSayfa)
    {
        return $"/Kitaplar?sayfa={hedefSayfa}&arama={Uri.EscapeDataString(aramaMetni)}&sirala={sirala}&kategoriId={kategoriId}";
    }
}

<div class="d-flex align-items-center">
    <div style="width:48px; flex-shrink:0;">
        @if (mevcutSayfa > 1)
        {
            <a href="@SayfaLinki(mevcutSayfa - 1)" class="btn btn-light shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width:44px; height:44px; font-size:1.5rem;">&lsaquo;</a>
        }
    </div>

    <div class="row g-3 flex-grow-1">
        @foreach (var kitap in Model)
        {
            <div class="col-md-3">
                <div class="card h-100 shadow-sm" style="border-radius: 12px;">
                    @if (!string.IsNullOrEmpty(kitap.ResimYolu))
                    {
                        <img src="@kitap.ResimYolu" class="card-img-top" style="height: 200px; object-fit: cover; border-radius: 12px 12px 0 0;" alt="@kitap.Baslik" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-light" style="height: 200px; border-radius: 12px 12px 0 0; font-size: 3rem;">
                            📕
                        </div>
                    }
                    <div class="card-body">
                        <h6 class="card-title">@kitap.Baslik</h6>
                        <p class="card-text small text-muted mb-1">@(kitap.Yazar?.AdSoyad ?? "Bilinmiyor")</p>
                        <p class="card-text small mb-2">@(kitap.Kategori?.Ad ?? "-")</p>
                        @if (kitap.OduncDurumu)
                        {
                            <span class="badge bg-danger">Ödünçte</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Rafta</span>
                        }
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <div class="mt-2">
                                <a asp-action="Edit" asp-route-id="@kitap.KitapID" class="btn btn-sm btn-warning">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@kitap.KitapID" class="btn btn-sm btn-danger">Sil</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div style="width:48px; flex-shrink:0; text-align:right;">
        @if (mevcutSayfa < toplamSayfa)
        {
            <a href="@SayfaLinki(mevcutSayfa + 1)" class="btn btn-light shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width:44px; height:44px; font-size:1.5rem; margin-left:auto;">&rsaquo;</a>
        }
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted mt-3">Aramanıza uygun kitap bulunamadı.</p>
}

@if (toplamSayfa > 1)
{
    <div class="mt-4 d-flex gap-2 justify-content-center">
        @for (int i = 1; i <= toplamSayfa; i++)
        {
            int sayfaNo = i;
            if (sayfaNo == mevcutSayfa)
            {
                <span class="btn btn-primary">@sayfaNo</span>
            }
            else
            {
                <a href="@SayfaLinki(sayfaNo)" class="btn btn-outline-primary">@sayfaNo</a>
            }
        }
    </div>
}