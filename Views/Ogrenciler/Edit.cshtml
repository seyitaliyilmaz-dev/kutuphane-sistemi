@model kutuphane_sistemi.Models.Ogrenci

<h2>Öğrenci Düzenle</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="OgrenciID" />

    <div class="mb-3">
        <label>Ad Soyad</label>
        <input asp-for="AdSoyad" class="form-control" />
        <span asp-validation-for="AdSoyad" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label>Öğrenci No</label>
        <input asp-for="OgrenciNo" class="form-control" />
        <span asp-validation-for="OgrenciNo" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>