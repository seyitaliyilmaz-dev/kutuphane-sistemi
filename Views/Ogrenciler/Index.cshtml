@model List<kutuphane_sistemi.Models.Ogrenci>

<h2>Öğrenci Listesi</h2>
<p class="text-muted">Öğrenciler kendi hesaplarını kayıt sayfasından oluşturur. Buradan sadece düzenleme/silme yapılabilir.</p>

<table class="table">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Öğrenci No</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ogrenci in Model)
        {
            <tr>
                <td>@ogrenci.AdSoyad</td>
                <td>@ogrenci.OgrenciNo</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@ogrenci.OgrenciID" class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@ogrenci.OgrenciID" class="btn btn-sm btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>