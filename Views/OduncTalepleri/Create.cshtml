@model kutuphane_sistemi.Models.OduncTalebi

<h2>Kitap Talep Et</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label>Kitap</label>
        <select asp-for="KitapID" class="form-control">
            <option value="0">-- Seçiniz --</option>
            @foreach (var kitap in (List<kutuphane_sistemi.Models.Kitap>)ViewBag.Kitaplar)
            {
                <option value="@kitap.KitapID">@kitap.Baslik</option>
            }
        </select>
        <span asp-validation-for="KitapID" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Talep Oluştur</button>
    <a asp-action="Index" class="btn btn-secondary">İptal</a>
</form>