@model List<kutuphane_sistemi.Models.OduncTalebi>

<h2>Ödünç Talepleri</h2>

@if (TempData["Hata"] != null)
{
    <div class="alert alert-danger">@TempData["Hata"]</div>
}

@if (!User.IsInRole("Admin"))
{
    <a asp-action="Create" class="btn btn-primary mb-3">+ Yeni Talep Oluştur</a>
}

<table class="table">
    <thead>
        <tr>
            <th>Kitap</th>
            @if (User.IsInRole("Admin"))
            {
                <th>Öğrenci</th>
            }
            <th>Talep Tarihi</th>
            <th>Durum</th>
            @if (User.IsInRole("Admin"))
            {
                <th>İşlemler</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var talep in Model)
        {
            <tr>
                <td>@(talep.Kitap?.Baslik ?? "Bilinmiyor")</td>
                @if (User.IsInRole("Admin"))
                {
                    <td>@(talep.Ogrenci?.AdSoyad ?? "Bilinmiyor")</td>
                }
                <td>@talep.TalepTarihi.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (talep.Durum == "Beklemede")
                    {
                        <span class="badge bg-warning">Beklemede</span>
                    }
                    else if (talep.Durum == "Onaylandi")
                    {
                        <span class="badge bg-success">Onaylandı</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Reddedildi</span>
                    }
                </td>
                @if (User.IsInRole("Admin"))
                {
                    <td>
                        @if (talep.Durum == "Beklemede")
                        {
                            <form asp-action="Onayla" asp-route-id="@talep.OduncTalebiID" method="post" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-success">Onayla</button>
                            </form>
                            <form asp-action="Reddet" asp-route-id="@talep.OduncTalebiID" method="post" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-danger">Reddet</button>
                            </form>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>